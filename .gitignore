# Local working assets (source videos, reference links) — not site source
/project/
.claude-replay.*
.tmp-*

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/
/.claude/
/.mcp.json

# .figma/make/* is imported by vite.config.ts (site.json) and holds the
# toolchain scripts, so it must stay tracked. Only the attachments are noise.
/.figma/attachments/

.vercel
.env*
